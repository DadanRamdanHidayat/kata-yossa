# Neon (pakai connection string yang pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth (buat secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email admin yang otomatis jadi admin + approved, pisahkan dengan koma
ADMIN_EMAILS="emailkamu@gmail.com"

# Resend (OTP email). Sebelum domain diverifikasi, hanya bisa kirim ke email akun Resend sendiri
RESEND_API_KEY=""
EMAIL_FROM="Kata Yossa <onboarding@resend.dev>"

# ── Penyedia AI ──
# Pilih salah satu: gemini | groq | mistral | cerebras | openrouter
AI_PROVIDER="gemini"
# Opsional: penyedia cadangan yang dipakai otomatis kalau penyedia utama gagal / kuotanya habis
AI_FALLBACK_PROVIDER=""

# Isi key hanya untuk penyedia yang dipakai. Nama model: cek dokumentasi masing-masing penyedia.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Tarif USD per 1 juta token, untuk estimasi biaya di dashboard admin.
# Isi dari halaman harga resmi tiap penyedia. Kosong = dianggap gratis ($0).
GEMINI_PRICE_IN="1.50"
GEMINI_PRICE_OUT="7.50"

# Batas pesan per pengguna per hari
DAILY_MESSAGE_LIMIT="30"

# Batas token total untuk tampilan persentase di dashboard admin
TOKEN_LIMIT="1000000"